; Engine configuration file.
; Godot 4.4+ - Autorennspiel

config_version=5

[application]

config/name="Autorennspiel"
config/description="Ein prozedural erzeugtes Rennspiel mit vier Fahrzeugen."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[physics]

3d/default_gravity=12.0
common/physics_ticks_per_second=120
; Godot rechnet hoechstens max_physics_steps_per_frame Schritte pro Bild.
; Bei 120 Schritten/s sind das 0.067 s Spielzeit je Bild - schafft der
; Browser nur wenige Bilder, laeuft das Spiel in Zeitlupe. 60 Schritte
; verdoppeln das Zeitbudget je Bild.
common/physics_ticks_per_second.web=60
common/max_physics_steps_per_frame=8
common/max_physics_steps_per_frame.web=16

[rendering]

renderer/rendering_method="forward_plus"
; Im Browser gibt es kein Forward+ - dort laeuft das Spiel ueber WebGL2.
renderer/rendering_method.web="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=3
textures/default_filters/anisotropic_filtering_level.web=0
lights_and_shadows/directional_shadow/size=8192
; 8k-Schatten, 4x MSAA und anisotropes Filtern sind fuer WebGL2 zu teuer.
lights_and_shadows/directional_shadow/size.web=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=0
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.web=0
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=true
; TAA gibt es nur in Forward+ - im Browser wuerde es nur eine Fehlermeldung geben.
anti_aliasing/quality/use_taa.web=false
environment/ssao/quality=3
environment/ssil/quality=2
environment/screen_space_reflection/roughness_quality=2
environment/subsurface_scattering/subsurface_scattering_quality=2
global_illumination/sdfgi/probe_ray_count=3
global_illumination/sdfgi/frames_to_converge=3
